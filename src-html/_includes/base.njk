<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <link rel="preload" href="../static/styles.css" as="style">
  <link rel="preload" as="font" type="font/woff2" crossorigin
    href="https://fonts.bunny.net/pacifico/files/pacifico-latin-400-normal.woff2">
  {% if page.url == '/' %}
    <link rel="preload" href="../static/client.js" as="script">  
    <link rel="preload" as="font" type="font/woff2" crossorigin
    href="https://fonts.gstatic.com/s/materialicons/v143/flUhRq6tzZclQEJ-Vdg-IuiaDsNc.woff2">
  {% endif %}
  <title>{{ title | default("qrr.app - fast sharing without login") }}</title>
  <link rel="icon" href="/favicon.ico" />
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1" name="viewport" />
  <meta name="description" content="{{ meta_description or description | default("A simple way to send files and messages - qrr.app") }}" />
  {%- if page.url == '/404/' %}
  <meta name="robots" content="noindex" />
  {%- endif %}
  {%- set pageTitle = title | default("qrr.app - fast sharing without login") %}
  {%- set pageDescription = meta_description or description | default("A simple way to send files and messages - qrr.app") %}
  <meta property="og:site_name" content="qrr.app" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="{{ ogTitle or pageTitle }}" />
  <meta property="og:description" content="{{ ogDescription or pageDescription }}" />
  <meta property="og:type" content="{% if 'blog' in (tags or []) %}article{% else %}website{% endif %}" />
  <meta property="og:url" content="{{ page.url | httpUrl }}" />
  <meta property="og:image" content="https://qrr.app/image/qrr-app-og.jpg" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1536" />
  <meta property="og:image:height" content="1024" />
  <meta property="og:image:alt" content="qrr.app – file and link sharing in the browser" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ twitterTitle or ogTitle or pageTitle }}" />
  <meta name="twitter:description" content="{{ twitterDescription or ogDescription or pageDescription }}" />
  <meta name="twitter:image" content="https://qrr.app/image/qrr-app-og.jpg" />
  {%- if page.url == '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://qrr.app/#website",
        "url": "https://qrr.app/",
        "name": "qrr.app",
        "inLanguage": "en"
      },
      {
        "@type": "WebApplication",
        "@id": "https://qrr.app/#app",
        "name": "qrr.app",
        "url": "https://qrr.app/",
        "description": {{ pageDescription | dump | safe }},
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Android, iOS, Windows, macOS, Linux",
        "browserRequirements": "Requires a modern browser with JavaScript",
        "inLanguage": "en",
        "isAccessibleForFree": true,
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "featureList": [
          "Send files up to 80 MB without an account",
          "Connect devices with a QR code or 6-digit code",
          "Send links and text between phone and computer",
          "No compression – original photo quality",
          "Files are not stored on the server"
        ]
      }{% if faq %},
      {
        "@type": "FAQPage",
        "@id": "https://qrr.app/#faq",
        "mainEntity": [
          {%- for item in faq %}
          {
            "@type": "Question",
            "name": {{ item.q | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
          }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ]
      }{% endif %}
    ]
  }
  </script>
  {%- elif 'blog' in (tags or []) %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "description": {{ pageDescription | dump | safe }},
    "url": "{{ page.url | httpUrl }}",
    "mainEntityOfPage": "{{ page.url | httpUrl }}",
    "inLanguage": "en",
    "datePublished": "{{ (published or page.date) | dateDisplay }}",
    "dateModified": "{{ page.date | dateDisplay }}",
    "image": "https://qrr.app/image/qrr-app-og.jpg",
    "author": { "@type": "Organization", "name": "qrr.app", "url": "https://qrr.app/" },
    "publisher": { "@type": "Organization", "name": "qrr.app", "url": "https://qrr.app/",
      "logo": { "@type": "ImageObject", "url": "https://qrr.app/icons/android-chrome-512x512.png" } }
  }
  </script>
  {%- endif %}
  <link rel="canonical" href="{{ page.url | httpUrl }}" />
  <link rel="sitemap" type="application/xml" title="Sitemap" href="https://qrr.app/sitemap.xml" />
  <link rel="manifest" href="../app.webmanifest" />
  <link rel="stylesheet" href="../static/styles.css" />
  {# <script src="https://cdn.jsdelivr.net/npm/eruda"></script><script>eruda.init();</script> #}
  {% if page.url == '/' %}
    <script src="../static/client.js" defer></script>
  {% endif %}
</head>

<body>
  <button class="theme-toggle icon" data-theme-toggle aria-label="Change to light theme"></button>
  {% block content %}{% endblock %}
  {% if page.url == '/' or page.url == '/404/' %}
    {{ content | safe }}
  {% endif %}
  

  {% include "footer.njk" %}

  {% include "dark_mode_script.njk" %}
  {% if page.url == '/' %}
    {% include "tile_scroll_script.njk" %}
  {% endif %}
  
</body>
</html>
