{% extends "base.njk" %}

{% block content %}
	<a href="{{ '/' | httpUrl }}" class="logo-link">
		<h2 class="mid logo">qrr.app</h2>
	</a>
<article class="blog-post">
  <header>
    <h1>{{ title }}</h1>
    {% if description %}
      <p class="lead">{{ description }}</p>
    {% endif %}
    {# {% if page.date %}
      <p class="meta">📅 {{ page.date | date("dd.MM.yyyy") }}</p>
    {% endif %} #}
  </header>
  <section class="post-body">
    {{ content | safe }}
  </section>

  <div class="card cta">
    <h3 class="m0">{{ cta_title or "Try qrr.app today!" }}</h3>
    <p>{{ cta_text or "Share files between any devices instantly and without installation." }}</p>
    <a href="/" class="button primary">
      <i class="material-icons">sync_alt</i>
      {{ cta_button_label or "Start sharing" }}
    </a>
  </div>
</article>
{% endblock %}
